# ---------------------------------------------------------------------------
# (SheepFox) Zen browser — Editor configuration
# https://editorconfig.org
# ---------------------------------------------------------------------------
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{sh,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Unified diffs MUST preserve context-line whitespace and exact line endings.
[*.{patch,diff}]
trim_trailing_whitespace = false
insert_final_newline = false

# Windows launchers are parsed by cmd.exe / powershell.exe and require CRLF.
[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
