# ============================================================================
# (SheepFox) Firefox — Linux aarch64 (ARM64 / NEON) release mozconfig
# Target: Raspberry Pi 5, Ampere, Graviton, Apple-silicon Linux VMs, Asahi.
# ============================================================================
. "$topsrcdir/../mozbuild/mozconfig.common"

# --- ARMv8-A baseline with NEON (mandatory on aarch64) ----------------------
export CFLAGS="-O3 -fno-semantic-interposition"
export CXXFLAGS="-O3 -fno-semantic-interposition"
export RUSTFLAGS="-C target-cpu=generic"

# --- Linker: LLD ------------------------------------------------------------
ac_add_options --enable-linker=lld

# --- Full cross-language LTO (cross PGO needs matching host/guest profiles) --
ac_add_options --enable-lto=full

# --- Optional two-stage PGO (same contract as the x86_64 mozconfig) ---------
if [ "${SHEEPFOX_PGO:-0}" = "1" ]; then
  export MOZ_PGO=1
  if [ -n "${SHEEPFOX_PGO_PROFILE:-}" ]; then
    ac_add_options --enable-profile-use=cross
    ac_add_options --with-pgo-profile-path=${SHEEPFOX_PGO_PROFILE}
  else
    ac_add_options --enable-profile-generate=cross
  fi
fi
