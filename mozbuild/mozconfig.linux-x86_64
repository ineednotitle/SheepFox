# ============================================================================
# (SheepFox) Zen browser — Linux x86_64 (x86-64-v3 / AVX2 + FMA) release mozconfig
# Requires clang + LLD (Rust cross-language LTO needs clang, not GCC).
#   ./mach bootstrap   OR   apt install clang lld libgtk-3-dev ...
# ============================================================================
. "$topsrcdir/../mozbuild/mozconfig.common"

# --- x86-64-v3 baseline: AVX2, BMI1/2, FMA, F16C ----------------------------
# This is the widest baseline that still runs on every Intel Haswell (2013+)
# and AMD Excavator/Zen (2015+) CPU, which covers the vast majority of the
# machines people actually browse on. Older CPUs must use the generic build.
export CFLAGS="-march=x86-64-v3 -O3 -fno-semantic-interposition"
export CXXFLAGS="-march=x86-64-v3 -O3 -fno-semantic-interposition"
export RUSTFLAGS="-C target-cpu=x86-64-v3"

# --- Linker: LLD (much faster links, smaller binaries) ----------------------
ac_add_options --enable-linker=lld

# --- Cross-language LTO -----------------------------------------------------
ac_add_options --enable-lto=cross

# --- Optional two-stage PGO -------------------------------------------------
# Stage 1 (no SHEEPFOX_PGO_PROFILE): instrumented build that writes .profraw
# Stage 2 (SHEEPFOX_PGO_PROFILE=/abs/path/merged.profdata): optimised rebuild
# mozbuild/scripts/build-browser.sh drives both stages when SHEEPFOX_PGO=1.
if [ "${SHEEPFOX_PGO:-0}" = "1" ]; then
  export MOZ_PGO=1
  if [ -n "${SHEEPFOX_PGO_PROFILE:-}" ]; then
    ac_add_options --enable-profile-use=cross
    ac_add_options --with-pgo-profile-path=${SHEEPFOX_PGO_PROFILE}
  else
    ac_add_options --enable-profile-generate=cross
  fi
fi
