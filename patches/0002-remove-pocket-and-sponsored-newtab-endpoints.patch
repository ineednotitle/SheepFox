From 0000000000000000000000000000000000000002 Mon Sep 17 00:00:00 2001
From: SheepFox Maintainers <maintainers@sheepfox.project>
Date: Fri, 30 Oct 2026 00:00:00 +0000
Subject: [PATCH 2/4] Disable Pocket, sponsored New Tab tiles, and QuickSuggest ads

---
 browser/app/profile/firefox.js | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/browser/app/profile/firefox.js b/browser/app/profile/firefox.js
index 9c30e14..7f19d02 100644
--- a/browser/app/profile/firefox.js
+++ b/browser/app/profile/firefox.js
@@ -1820,6 +1820,6 @@
 // Pocket & New Tab Sponsored Streams
-pref("extensions.pocket.enabled", true);
-pref("browser.newtabpage.activity-stream.showSponsored", true);
-pref("browser.newtabpage.activity-stream.showSponsoredTopSites", true);
-pref("browser.urlbar.suggest.quicksuggest.sponsored", true);
-pref("browser.vpn_promo.enabled", true);
+pref("extensions.pocket.enabled", false);
+pref("browser.newtabpage.activity-stream.showSponsored", false);
+pref("browser.newtabpage.activity-stream.showSponsoredTopSites", false);
+pref("browser.urlbar.suggest.quicksuggest.sponsored", false);
+pref("browser.vpn_promo.enabled", false);
