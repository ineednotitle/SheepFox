# Normalize text files to LF, but store the Windows launchers verbatim (-text)
# so they are CRLF every way a user can get them - git clone, and also the ZIP
# download of the repo, which skips checkout-time eol conversion.
* text=auto eol=lf
*.bat -text
*.cmd -text
*.ps1 -text
*.patch -text
*.diff -text
*.svg text
*.command text eol=lf
